# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_monitor

# Encryption at rest (Fernet key, 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=9Yg0z4t2-6M08Wf-l7-8Rk1M4w_XN8fR9_a1b2c3d4e=

# Optional comma-separated keys for zero-downtime rotation (newest first)
ROTATION_ENCRYPTION_KEYS=

# Notifications: Slack
SLACK_WEBHOOK_URL=

# Notifications: Email (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com
SMTP_TO=dev-alerts@yourdomain.com

# Defaults
DEFAULT_RATE_LIMIT_THRESHOLD=80.0
DEFAULT_LATENCY_ZSCORE_THRESHOLD=3.0
HTTP_REQUEST_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2
